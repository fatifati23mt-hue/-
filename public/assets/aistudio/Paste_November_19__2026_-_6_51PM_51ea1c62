            activeEl.classList.remove('border', 'border-slate-700');
            activeEl.classList.add('border-2', 'border-gold', 'bg-gold/10');

            // Update Teacher Stats & Revenue
            refreshTeacherStats();

            if (!silent) {
                showToast(`تم تفعيل (${secName}) بسعر ${price.toLocaleString()} دج في جميع البوابات.`);
            }
        }

        // Student Actions
        function enrollInSelectedSection() {
            const sec = appState.activeSection;
            const meta = appState.sectionsMeta[sec];
            const price = appState.prices[sec];

            if (meta.max !== Infinity && meta.reg >= meta.max) {
                return showToast(`عذراً! (${sec}) مكتمل السعة (${meta.max}/${meta.max}). يمكنك اختيار قسم آخر.`);
            }
            meta.reg += 1;
            meta.pres += 1;
            refreshTeacherStats();
            showToast(`تم تسجيل التلميذ بنجاح في (${sec}) بسعر ${price.toLocaleString()} دج!`);
        }

